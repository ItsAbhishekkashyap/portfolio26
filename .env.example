# Copy to .env.local and fill in. Every value is optional for local development.

# MongoDB connection string. Without it, projects and messages live in memory.
MONGODB_URI=

# Secret used to sign the admin session cookie.
JWT_SECRET=

# Admin Studio sign-in at /admin/login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Gemini API key for the "Ask about Abhishek" chat (https://aistudio.google.com/apikey).
# Without it, the chat answers straight from the resume notes.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite, falls back to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
