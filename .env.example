# Copy to .env.local and fill in. Every value is optional for local development.

# MongoDB connection string. Without it, projects and messages live in memory.
MONGODB_URI=

# Secret used to sign the admin session cookie.
JWT_SECRET=

# Admin Studio sign-in at /admin/login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Gemini API key for the "Ask about Abhishek" chat (https://aistudio.google.com/apikey).
# Without it, the chat answers straight from the resume notes.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite, falls back to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# WhatsApp alerts + inbox bot (WhatsApp Cloud API, Meta for Developers).
# Permanent system-user token with whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_TOKEN=
# "Phone number ID" from the app's WhatsApp > API Setup page (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Your personal WhatsApp number that receives alerts, with country code, digits only (e.g. 9198xxxxxxxx).
WHATSAPP_NOTIFY_TO=
# Approved utility template with 4 body variables: name, email, subject, message. Leave empty to send plain text
# (plain text only arrives within 24 hours of you messaging the bot).
WHATSAPP_TEMPLATE=portfolio_message
WHATSAPP_TEMPLATE_LANG=en
# Webhook for the inbox bot: any random string you also paste into Meta's webhook settings, and the app secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0
